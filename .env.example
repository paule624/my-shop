# Copy to .env and fill with Supabase > Project Settings > API values.
# Only the public anon key here, never the service_role key.
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Playwright sign-in journey (e2e/auth.spec.ts): a TEST account of this project, never a personal one.
# Left empty, that test is skipped.
E2E_EMAIL=
E2E_PASSWORD=
